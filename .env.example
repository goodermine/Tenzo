LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=PASTE_YOUR_KEY_HERE

# Ramblbox v0
RAMBLBOX_DB_PATH=ramblbox.db
TRANSCRIBE_MODEL=whisper-1
# true: no audio leaves the machine, a placeholder transcript is used (default).
# false: transcribe segments via {LLM_BASE_URL}/audio/transcriptions using LLM_API_KEY.
TRANSCRIBE_STUB=true
