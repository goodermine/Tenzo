LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=PASTE_YOUR_KEY_HERE

# Ramblbox v0 — the app stores audio and notifies your agent; it calls no LLM.
RAMBLBOX_DB_PATH=ramblbox.db
RAMBLBOX_AUDIO_DIR=ramblbox_audio
# Optional push-on-Done so the agent runs only when you finish a ramble (no idle polling).
# HTTP push (if your agent exposes an endpoint):
AGENT_WEBHOOK_URL=
# Telegram push (wakes an agent that listens on Telegram, e.g. Hermes via OpenClaw):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
