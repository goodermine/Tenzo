LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=PASTE_YOUR_KEY_HERE

# Ramblbox v0 — the app stores audio and notifies your agent; it calls no LLM.
RAMBLBOX_DB_PATH=ramblbox.db
RAMBLBOX_AUDIO_DIR=ramblbox_audio
# Optional: POSTed to the instant you press "Done", so your agent starts immediately.
# Leave empty to disable push (the agent can still poll GET /agent/pending).
AGENT_WEBHOOK_URL=
