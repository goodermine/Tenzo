{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VOX Coaching Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "scores",
    "observations",
    "next_steps",
    "warnings"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitch_stability",
        "dynamic_control",
        "timing_consistency",
        "overall"
      ],
      "properties": {
        "pitch_stability": { "type": "integer", "minimum": 0, "maximum": 10 },
        "dynamic_control": { "type": "integer", "minimum": 0, "maximum": 10 },
        "timing_consistency": { "type": "integer", "minimum": 0, "maximum": 10 },
        "overall": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "next_steps": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
