{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramblbox Session Note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "category",
    "decisions",
    "action_items",
    "open_questions",
    "tags",
    "warnings"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "build_priority",
        "customer_feedback",
        "fundraising",
        "personal",
        "other"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "urgency"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "urgency": { "type": "string", "enum": ["low", "med", "high"] },
          "owner": { "type": "string" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
